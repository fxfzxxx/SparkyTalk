# apps/api
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sparkytalk
ANTHROPIC_API_KEY=
PORT=8787
# "dev" enables the x-dev-user-id header stub. Never set in production.
AUTH_MODE=dev
# Comma-separated origins allowed to call the API (admin site on Netlify, Expo dev)
CORS_ORIGINS=http://localhost:3000

# apps/admin
NEXT_PUBLIC_API_URL=http://localhost:8787

# apps/mobile
EXPO_PUBLIC_API_URL=http://localhost:8787
