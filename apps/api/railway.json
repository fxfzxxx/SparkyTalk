{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @sparkytalk/api... build"
  },
  "deploy": {
    "preDeployCommand": "pnpm --filter @sparkytalk/api db:migrate",
    "startCommand": "pnpm --filter @sparkytalk/api start",
    "healthcheckPath": "/health"
  }
}
